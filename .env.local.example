# Option A (recommended for local dev): point at your downloaded service
# account key file directly. Get this the same way you did for the Pi's
# firebase_key.json (Firebase Console -> Project Settings -> Service
# Accounts -> Generate New Private Key).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase_key.json

# Option B (for deployment, e.g. Vercel): paste the ENTIRE key file's
# JSON contents as a single-line string here instead. If both are set,
# FIREBASE_SERVICE_ACCOUNT_KEY takes priority.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...",...}
